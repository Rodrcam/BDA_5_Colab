# database.ini.example
# Copy this file to database.ini and fill in your values.
# The application reads configuration from ENVIRONMENT VARIABLES, not this file.
# Set the following env vars before running the app:
#
#   DB_HOST      (default: localhost)
#   DB_NAME      (default: gestorclases)
#   DB_USER      (default: postgres)
#   DB_PASSWORD  (default: empty)
#   DB_PORT      (default: 5432)
#   SQLITE_PATH  (default: ./auth.db)
#   SERVER_IP    (default: 0.0.0.0)
#   SERVER_PORT  (default: 3000)
#   TEMPLATE_DIR (default: ./templates)
#   PAGE_SIZE    (default: 10)
#   SECRET_KEY   (default: dev-secret-bda-practica3)
#
# Example .env file (use with python-dotenv or export manually):
#
# DB_HOST=localhost
# DB_NAME=gestorclases
# DB_USER=postgres
# DB_PASSWORD=mysecretpassword
# DB_PORT=5432
# SQLITE_PATH=./auth.db
# SERVER_IP=0.0.0.0
# SERVER_PORT=3000
# SECRET_KEY=change-me-in-production
